#!/bin/sh
# bt-uart — the Raspberry Pi 5's on-board Bluetooth (CYW43455 on a UART). See docs/RASPBERRY.md,
# "Bluetooth".
#
# The kernel does the bring-up by itself: the device tree's serdev node binds hci_uart (BCM
# protocol), btbcm loads brcm/BCM4345C0.hcd (Debian's bluez-firmware) and the board address comes
# from the device tree (local-bd-address, filled in by the firmware). So unlike the older boards
# there is no hciattach here. What this helper adds, once per controller, is the one setting the
# kernel doesn't make: SCO (call audio, HFP/HSP headsets) routed over HCI instead of the chip's PCM
# pins, which the Pi doesn't wire, with the chip's vendor command Write_SCO_PCM_Int_Param (0xfc1c).
# It only writes when the read-back (0xfc1d) differs, leaves the controller powered as it found
# it, does nothing for a controller that isn't a UART one or is blocked by rfkill, and never fails
# the boot.
#
# Usage (lordos-rpi-bt@.service, started by udev for hciN on the serial bus): bt-uart hciN
PATH=/usr/sbin:/usr/bin:/sbin:/bin
dev=${1:-}
case "$dev" in hci[0-9]|hci[0-9][0-9]) ;; *) echo "bt-uart: usage: bt-uart hciN" >&2; exit 0 ;; esac
[ -d "/sys/class/bluetooth/$dev" ] || exit 0
command -v hciconfig > /dev/null && command -v hcitool > /dev/null || {
    echo "bt-uart: hciconfig/hcitool missing (package bluez)" >&2; exit 0; }
if command -v rfkill > /dev/null && rfkill -nro DEVICE,SOFT list 2>/dev/null | grep -q "^$dev blocked"; then
    echo "bt-uart: $dev is blocked by rfkill; nothing to do"; exit 0
fi
info=$(hciconfig "$dev" 2>/dev/null) || exit 0
echo "$info" | grep -q 'Bus: UART' || { echo "bt-uart: $dev is not a UART controller"; exit 0; }
raised=0
if ! echo "$info" | grep -q 'UP RUNNING'; then
    hciconfig "$dev" up 2>/dev/null || { echo "bt-uart: could not bring $dev up" >&2; exit 0; }
    raised=1
fi
addr=$(hciconfig "$dev" | sed -n 's/.*BD Address: \([0-9A-F:]*\).*/\1/p')
case "$addr" in
    43:45:C0:*|43:43:A1:*|AA:AA:AA:AA:AA:AA|00:00:00:00:00:00)
        echo "bt-uart: $dev still has the chip's default address $addr (no local-bd-address in the device tree?)" >&2 ;;
esac
# the reply's parameters after the status byte: routing, rate, frame type, sync mode, clock mode
want="01 02 00 01 01"
cur=$(hcitool -i "$dev" cmd 0x3f 0x1d 2>/dev/null | sed -n 's/^ *01 1D FC 00 \(.*[0-9A-F]\) *$/\1/p')
if [ "$cur" = "$want" ]; then
    echo "bt-uart: $dev ($addr): SCO already routed over HCI"
elif hcitool -i "$dev" cmd 0x3f 0x1c 0x01 0x02 0x00 0x01 0x01 > /dev/null 2>&1; then
    echo "bt-uart: $dev ($addr): SCO routed over HCI (was: ${cur:-unknown})"
else
    echo "bt-uart: $dev ($addr): could not set the SCO routing (headset microphones may not work)" >&2
fi
[ "$raised" = 1 ] && hciconfig "$dev" down 2>/dev/null
exit 0
