#!/bin/sh
# wait-kms — waits (up to 10 s) for some DRM card to have a connector (vc4 on the Raspberry Pi).
# With no monitor no connector is connected, but the connector still exists: it is enough for it to appear.
i=0
while [ $i -lt 100 ]; do
    for c in /sys/class/drm/card*-*; do
        [ -e "$c/status" ] && exit 0
    done
    sleep 0.1
    i=$((i + 1))
done
echo "wait-kms: no card with connectors after 10 s" >&2
exit 0
