# LordOS on Raspberry Pi: the on-board Bluetooth controller (a serdev child of a UART) gets its
# SCO routing from /usr/lib/lordos/rpi/bt-uart (lordos-rpi-bt@.service). See docs/RASPBERRY.md.
ACTION=="add", SUBSYSTEM=="bluetooth", KERNEL=="hci[0-9]*", ENV{DEVTYPE}=="host", SUBSYSTEMS=="serial", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}+="lordos-rpi-bt@%k.service"
