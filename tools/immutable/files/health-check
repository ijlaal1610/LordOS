#!/bin/sh
# /usr/lib/lordos/immutable/health-check — PROTOTYPE boot assessment (docs/IMMUTABLE.md).
# Required by boot-complete.target: while it fails, systemd-bless-boot never marks the boot entry
# good, and lordos-health-failed.service restarts, so systemd-boot spends the entry's tries and
# then falls back to the previous version. The real check would be "the login screen came up"
# (lord-sessiond reports ready), not this.
set -eu
fail() { echo "health-check: FAILED: $*"; exit 1; }

findmnt -no SOURCE /usr | grep -qx /dev/mapper/usr || fail "/usr is not the dm-verity device"
findmnt -no OPTIONS /usr | grep -q '^ro' || fail "/usr is not read-only"
[ -e /usr/lib/lordos/immutable/simulate-broken-release ] \
    && fail "this test release is built broken on purpose (simulate-broken-release)"
# shellcheck source=/dev/null
echo "health-check: OK ($(. /usr/lib/os-release; echo "image version $IMAGE_VERSION"), /usr verified read-only)"
