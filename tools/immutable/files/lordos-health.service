[Unit]
Description=LordOS health check (boot assessment)
Documentation=https://github.com/lordbasex/LordOS/blob/main/docs/IMMUTABLE.md
# boot-complete.target gates systemd-bless-boot.service, which marks the boot entry good
After=multi-user.target
Before=boot-complete.target
OnFailure=lordos-health-failed.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/lordos/immutable/health-check
