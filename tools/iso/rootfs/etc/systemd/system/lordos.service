[Unit]
Description=LordOS (lord-sessiond: login screen, sessions and remote desktop)
Documentation=file:///usr/share/doc/lordos/README.md
After=systemd-user-sessions.service systemd-logind.service systemd-udev-settle.service plymouth-start.service
Wants=systemd-udev-settle.service
# boot splash: ended (keeping our first frame) once LordOS is on the screen; see docs/SESSIONS.md,
# "Boot splash". No Conflicts= with plymouth-quit.service: that one is ordered after it instead.
Wants=lordos-splash-quit.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
# live only: grub language (lordos.lang) and the lordos user's folders
ExecStartPre=-/usr/lib/lordos/lordos-live-prep
# the last step before lord-sessiond: Plymouth drops DRM master and leaves its last frame up
ExecStartPre=-/usr/lib/lordos/lordos-splash deactivate
ExecStart=/usr/lib/lordos/bin/lord-sessiond
# SIGHUP: rereads /etc/lordos/remote/config (Settings → Sharing)
ExecReload=/bin/kill -HUP $MAINPID
TTYPath=/dev/tty1
# no TTYReset: it switches tty1 back to text mode before every Exec* line, and between Plymouth
# dropping DRM master and lord-sessiond taking it the console would flash on top of the splash
# (lord-sessiond sets graphics mode itself and restores text mode when it stops)
TTYReset=no
TTYVHangup=yes
StandardInput=null
StandardOutput=journal
StandardError=journal
# user sessions (lord-server) and their terminals survive a restart of the
# service: only the main process is stopped (on return, login goes through the login screen)
KillMode=process
# lord-sessiond splits up the cgroup tree: one branch per session and one scope per app (see docs/PRIVACY.md)
Delegate=yes
# the main process goes straight into the «supervisor» leaf: a restart with live processes (login screen, lord-netd, sessions) does not clash with the cgroup v2 rule
DelegateSubgroup=supervisor
# on shutdown: if something does not exit, it is killed after 5 s (not the default 90 s)
TimeoutStopSec=5
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
