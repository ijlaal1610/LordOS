[Unit]
Description=LordOS (lord-sessiond: pantalla de ingreso, sesiones y escritorio remoto)
Documentation=file:///usr/share/doc/lordos/README.md
After=systemd-user-sessions.service systemd-logind.service systemd-udev-settle.service
Wants=systemd-udev-settle.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
# solo en el live: idioma de grub (lordos.lang) y carpetas del usuario lordos
ExecStartPre=-/usr/lib/lordos/lordos-live-prep
ExecStart=/usr/lib/lordos/bin/lord-sessiond
# SIGHUP: vuelve a leer /etc/lordos/remote/config (Ajustes → Compartir)
ExecReload=/bin/kill -HUP $MAINPID
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=null
StandardOutput=journal
StandardError=journal
# las sesiones de los usuarios (lord-server) y sus terminales sobreviven a un reinicio del
# servicio: solo se para el principal (al volver, se entra por la pantalla de ingreso)
KillMode=process
# lord-sessiond reparte el árbol de cgroups: una rama por sesión y un scope por app (ver docs/PRIVACIDAD.md)
Delegate=yes
# el principal entra directo a la hoja «supervisor»: un reinicio con procesos vivos (pantalla de ingreso, lord-netd, sesiones) no choca con la regla de cgroup v2
DelegateSubgroup=supervisor
# al apagar: si algo no termina, a los 5 s se mata (no los 90 s por defecto)
TimeoutStopSec=5
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
