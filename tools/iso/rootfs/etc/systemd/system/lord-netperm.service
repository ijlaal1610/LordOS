[Unit]
Description=LordOS: per-app network permissions (lord-netperm)
After=systemd-resolved.service
Before=lordos.service

[Service]
Type=simple
ExecStart=/usr/lib/lordos/bin/lord-netperm
Restart=always
RestartSec=1
StandardOutput=journal
StandardError=journal
RuntimeDirectory=lordos
RuntimeDirectoryPreserve=yes
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_DAC_READ_SEARCH CAP_NET_RAW
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_PACKET
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
