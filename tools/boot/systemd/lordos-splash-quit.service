[Unit]
Description=LordOS: end the boot splash once the login screen is up
Documentation=file:///usr/share/doc/lordos/README.md
# started by lordos.service (Wants=); plymouth-quit.service is ordered after this one
# (plymouth-quit.service.d/lordos.conf), so Plymouth is never ended before LordOS has painted
After=lordos.service plymouth-start.service
ConditionPathExists=/usr/bin/plymouth

[Service]
Type=oneshot
ExecStart=/usr/lib/lordos/lordos-splash quit
TimeoutStartSec=60
